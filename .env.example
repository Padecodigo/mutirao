# Segredos não se versionam — este arquivo mostra só os NOMES.

# Preencha assim, no SEU computador, em um arquivo chamado .env
# (que o git ignora). Para projetos de verdade, use o cofre:
#   mutirao vault add STRIPE_SECRET_KEY
#   mutirao vault run -- npm run dev

# --- exemplo de projeto que aceita pagamento ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- exemplo de banco de dados ---
DATABASE_URL=

# --- exemplo de serviço de IA ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- exemplo de e-mail ---
SMTP_PASSWORD=

# .gitignore — define o que NUNCA entra no controle de versão.
# Objetivo: impedir vazamento de segredos, poluição do repositório por
# dependências instaladas e commits acidentais de lixo local.
# Regra inegociável (security/rules/security-rules.md): arquivo com chave,
# token, senha ou credencial não é versionado — em nenhuma hipótese.

# --- Segredos e credenciais (nunca versionar) ---
.env
.env.*
!.env.example
!.env.sample
.env.sample
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
secrets/
credentials.json

# --- Estado local do Mutirão (cofre local, worktrees, config) ---
.mutirao/

# --- Temporários ---
*.tmp
*.temp
*.bak
*.orig
tmp/
.cache/
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# --- Dependências / build (Node) ---
node_modules/
dist/
build/
.next/
out/
.npm/
.pnpm-store/

# --- Dependências / build (Python) ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- Editores ---
.vscode/
.idea/
*.swp
*.swo
